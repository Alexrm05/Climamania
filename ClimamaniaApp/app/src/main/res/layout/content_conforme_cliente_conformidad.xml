<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimaryLight"
    android:fillViewport="true"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_detail_hero"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Firma conforme cliente"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtConformeReferencia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Referencia"
                android:textColor="@color/colorPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtConformeCliente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Cliente"
                android:textColor="#757575"
                android:textSize="15sp" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:strokeColor="#EFE2D6"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Documento de conformidad"
                    android:textColor="@color/colorPrimaryDark"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtConformeDocumento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="3dp"
                    android:text="Cargando documento..."
                    android:textColor="#243241"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:strokeColor="#EFE2D6"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Observaciones"
                    android:textColor="@color/colorPrimaryDark"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="(En este apartado podrán hacerse constar cualquier incidencia, trabajo pendiente o comentario por parte del instalador o del cliente.)"
                    android:textColor="#6F6F6F"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/editConformeObservaciones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_edittext"
                    android:gravity="top"
                    android:hint="Escribe las observaciones"
                    android:inputType="textMultiLine"
                    android:minHeight="120dp"
                    android:padding="12dp"
                    android:textColor="@android:color/black"
                    android:textColorHint="@android:color/darker_gray" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Firmado por:"
                    android:textColor="@color/colorPrimaryDark"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/chkConformeClienteTitular"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Cliente / titular del pedido"
                    android:textColor="#243241"
                    android:textSize="15sp" />

                <CheckBox
                    android:id="@+id/chkConformeRepresentante"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Representante autorizado del cliente"
                    android:textColor="#243241"
                    android:textSize="15sp" />

                <LinearLayout
                    android:id="@+id/llConformeRepresentante"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/editConformeRepresentanteNombre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_edittext"
                        android:hint="Nombre"
                        android:inputType="textPersonName"
                        android:padding="12dp"
                        android:textColor="@android:color/black"
                        android:textColorHint="@android:color/darker_gray" />

                    <EditText
                        android:id="@+id/editConformeRepresentanteApellidos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_edittext"
                        android:hint="Apellidos"
                        android:inputType="textPersonName"
                        android:padding="12dp"
                        android:textColor="@android:color/black"
                        android:textColorHint="@android:color/darker_gray" />

                    <EditText
                        android:id="@+id/editConformeRepresentanteDni"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_edittext"
                        android:hint="DNI"
                        android:inputType="text"
                        android:padding="12dp"
                        android:textColor="@android:color/black"
                        android:textColorHint="@android:color/darker_gray" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtConformeRepresentanteAviso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="En caso de firmar en representación del cliente: La persona firmante declara que actúa en nombre o con la autorización del cliente indicado en el presente documento, y que firma tras haber revisado la instalación y prestar su conformidad con los trabajos realizados."
                    android:textColor="#6F6F6F"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:strokeColor="#EFE2D6"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/txtConformeFirmaContexto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Y para que así conste..."
                    android:textColor="#243241"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Declaro haber leído el documento y estar conforme con su contenido antes de firmar"
                    android:textColor="@color/colorPrimaryDark"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Firma manuscrita electrónica:"
                    android:textColor="#243241"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.example.climamaniaapp.SignaturePadView
                    android:id="@+id/signaturePadConforme"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_adicionales_signature" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConformeLimpiarFirma"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:text="Limpiar firma"
                    android:textAllCaps="false"
                    android:textColor="#35506B"
                    android:textStyle="bold"
                    app:backgroundTint="#EEF4FF"
                    app:cornerRadius="12dp"
                    app:strokeColor="#91A9CB"
                    app:strokeWidth="1dp" />

                <TextView
                    android:id="@+id/txtConformeFirmaPieNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="D./Dña.: ________________________________"
                    android:textColor="#243241"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txtConformeFirmaPieDni"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="DNI/NIF: ________________________________"
                    android:textColor="#243241"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConformeAceptar"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Aceptar"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:backgroundTint="#1FA764"
            app:cornerRadius="14dp"
            app:strokeColor="#18834E"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConformeVolver"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="6dp"
            android:text="Volver"
            android:textAllCaps="false"
            android:textColor="#3A4652"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="#F7F9FB"
            app:cornerRadius="14dp"
            app:strokeColor="#D5DEE8"
            app:strokeWidth="1dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
