<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="18dp"
    android:background="@color/colorPrimaryLight">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_detail_hero"
            android:padding="18dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Firma conforme cliente"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimaryDark" />

            <TextView
                android:id="@+id/txtConformeBoeReferencia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Referencia"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary" />

            <TextView
                android:id="@+id/txtConformeBoeCliente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Cliente"
                android:textSize="15sp"
                android:textColor="#757575" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@android:color/white"
            app:strokeWidth="1dp"
            app:strokeColor="#EFE2D6">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="¿La instalación requiere BOE?"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorPrimaryDark"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Selecciona una opción para continuar con el flujo correspondiente en la siguiente fase."
                    android:textSize="13sp"
                    android:textColor="#6F6F6F"
                    android:layout_marginBottom="14dp" />

                <RadioGroup
                    android:id="@+id/rgConformeBoeDecision"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/rbConformeBoeSi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sí requiere BOE"
                        android:textSize="16sp"
                        android:textColor="@color/colorPrimaryDark"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp" />

                    <RadioButton
                        android:id="@+id/rbConformeBoeNo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No requiere BOE"
                        android:textSize="16sp"
                        android:textColor="@color/colorPrimaryDark"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConformeBoeContinuar"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Continuar"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            app:backgroundTint="@color/colorPrimary"
            app:cornerRadius="5dp"
            android:enabled="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConformeBoeVolver"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="Volver"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="@color/colorPrimaryDark"
            android:textSize="15sp"
            app:backgroundTint="@android:color/white"
            app:strokeColor="@color/colorPrimaryDark"
            app:strokeWidth="1dp"
            app:cornerRadius="5dp" />

    </LinearLayout>
</ScrollView>
