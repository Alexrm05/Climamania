<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.climamania.adminpanel.controllers.LoginController">
    <left>
        <StackPane styleClass="brand-panel">
            <VBox spacing="12" alignment="CENTER">
                <Label text="ClimaMania" styleClass="brand-title" />
                <Label text="Admin Panel" styleClass="brand-subtitle" />
            </VBox>
        </StackPane>
    </left>
    <center>
        <VBox spacing="14" alignment="CENTER" padding="24">
            <Label text="Acceso" styleClass="section-title" />
            <VBox spacing="10" maxWidth="320">
                <Label text="Usuario" styleClass="field-label" />
                <TextField fx:id="txtUsuario" promptText="usuario" />
                <Label text="Contrasenya" styleClass="field-label" />
                <PasswordField fx:id="txtContrasenya" promptText="contrasenya" />
            </VBox>
            <HBox spacing="10" alignment="CENTER">
                <Button fx:id="btnLogin" text="Entrar" onAction="#onLogin" styleClass="primary-button" />
            </HBox>
            <Label fx:id="lblStatus" text="" styleClass="status-label" />
        </VBox>
    </center>
</BorderPane>
