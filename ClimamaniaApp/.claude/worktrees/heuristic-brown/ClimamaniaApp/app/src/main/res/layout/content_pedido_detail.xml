<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimaryLight">

    <ScrollView
        android:id="@+id/scrollPedido"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_detail_hero"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ficha completa"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#6D4C41"
                        android:letterSpacing="0.05" />

                    <TextView
                        android:id="@+id/txtPedidoReferencia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="REFERENCIA"
                        android:textSize="36sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorPrimary" />

                    <TextView
                        android:id="@+id/txtPedidoCliente"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Cliente"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorPrimaryDark" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtPedidoFechaHora"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorPrimaryDark"
                    android:gravity="end"
                    android:background="@drawable/bg_chip_light"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="18dp"
                android:background="#F2D9C2" />

            <TextView
                android:id="@+id/txtPedidoDireccionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dirección de instalación"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimaryDark"
                android:paddingBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_address_highlight"
                android:padding="12dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/txtPedidoDireccion"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Dirección"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#263238"
                    android:lineSpacingMultiplier="1.4" />

                <ImageButton
                    android:id="@+id/btnDireccionMapa"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_chip_light"
                    android:src="@android:drawable/ic_menu_mapmode"
                    android:tint="@color/colorPrimaryDark"
                    android:contentDescription="Abrir mapa" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_address_highlight"
                android:padding="10dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/txtPedidoTelefono"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Teléfono"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#37474F" />

                <ImageButton
                    android:id="@+id/btnTelefonoLlamar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_chip_light"
                    android:src="@android:drawable/ic_menu_call"
                    android:tint="@color/colorPrimaryDark"
                    android:contentDescription="Llamar" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_address_highlight"
                android:padding="10dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/txtPedidoWhatsapp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="WhatsApp"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#37474F" />

                <ImageButton
                    android:id="@+id/btnWhatsapp"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_chip_light"
                    android:src="@android:drawable/ic_menu_send"
                    android:tint="@color/colorPrimaryDark"
                    android:contentDescription="Enviar WhatsApp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sectionEquipo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:background="@drawable/bg_detail_card"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Equipo asignado"
                android:textColor="@color/colorPrimaryDark"
                android:textStyle="bold"
                android:textSize="15sp"
                android:paddingBottom="6dp" />

            <TextView
                android:id="@+id/txtPedidoEquipo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#424242"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>


        <LinearLayout
            android:id="@+id/sectionDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:background="@drawable/bg_detail_card"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Detalle del pedido"
                android:textColor="@color/colorPrimaryDark"
                android:textStyle="bold"
                android:textSize="15sp"
                android:paddingBottom="6dp" />

            <LinearLayout
                android:id="@+id/llPedidoDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sectionObservaciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:background="@drawable/bg_detail_card"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Observaciones del cliente"
                android:textColor="@color/colorPrimaryDark"
                android:textStyle="bold"
                android:textSize="15sp"
                android:paddingBottom="6dp" />

            <TextView
                android:id="@+id/txtPedidoObservaciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#424242"
                android:textSize="16sp"
                android:lineSpacingMultiplier="1.5"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sectionComentarios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:background="@drawable/bg_detail_card"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Comentarios del instalador"
                android:textColor="@color/colorPrimaryDark"
                android:textStyle="bold"
                android:textSize="15sp"
                android:paddingBottom="6dp" />

            <TextView
                android:id="@+id/txtPedidoComentarios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#424242"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp" />

            <EditText
                android:id="@+id/editPedidoComentario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_edittext"
                android:hint="Añadir comentario..."
                android:inputType="textMultiLine"
                android:minLines="3"
                android:maxLines="6"
                android:padding="12dp"
                android:textColor="#424242"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnPedidoAddComentario"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_action_primary"
                android:text="Guardar comentario"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sectionFotos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:background="@drawable/bg_detail_card"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fotografías"
                android:textColor="@color/colorPrimaryDark"
                android:textStyle="bold"
                android:textSize="15sp"
                android:paddingBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Cliente"
                android:textStyle="bold"
                android:textColor="#616161"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/txtPedidoFotosCliente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#424242"
                android:textSize="15sp"
                android:lineSpacingExtra="3dp" />

            <Button
                android:id="@+id/btnPedidoFotosCliente"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_action_primary"
                android:text="Ver fotos del cliente"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Espaciador inferior para que los flotantes no tapen el contenido -->
        <View
            android:layout_width="match_parent"
            android:layout_height="130dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Botones flotantes inferiores -->
    <LinearLayout
        android:id="@+id/layoutPedidoActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="12dp"
        android:layout_marginBottom="8dp"
        android:background="@android:color/transparent">

        <LinearLayout
            android:layout_width="764dp"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="horizontal"
            android:padding="5dp"
            app:cornerRadius="5dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRealizarInstalacion"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:backgroundTint="@color/colorPrimary"
                android:text="Realizar instalación"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                app:cornerRadius="5dp" />

            <View
                android:layout_width="10dp"
                android:layout_height="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPedidoVolver"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="Volver"
                android:textAllCaps="false"
                android:textColor="@color/colorPrimaryDark"
                android:textStyle="bold"
                app:backgroundTint="@android:color/white"
                app:cornerRadius="5dp"
                app:strokeColor="@color/colorPrimaryDark"
                app:strokeWidth="1dp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
