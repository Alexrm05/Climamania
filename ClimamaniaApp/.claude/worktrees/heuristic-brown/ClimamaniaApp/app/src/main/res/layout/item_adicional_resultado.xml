<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    app:cardBackgroundColor="#FFFFFC"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:strokeColor="#E7C9A8"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/txtResultadoCodigo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CODIGO"
            android:textColor="#8A4A07"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtResultadoDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Descripcion del articulo"
            android:textColor="#1F2933"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtResultadoMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Selecciona para anadir al presupuesto"
            android:textColor="#5C6A73"
            android:textSize="12sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
