<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_visitas_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_visitas_hero"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/txtAdicionalesSaludo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hola instalador"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtAdicionalesReferencia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Referencia sin seleccionar"
                android:textAllCaps="true"
                android:textColor="#7A654F"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtAdicionalesTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Presupuesto de adicionales"
            android:textColor="@color/colorPrimaryDark"
            android:textSize="24sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdicionalTabNuevo"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Nuevo"
                android:textAllCaps="false"
                android:textColor="#7B4C16"
                android:textStyle="bold"
                app:backgroundTint="#FFF6E8"
                app:cornerRadius="12dp"
                app:strokeColor="#CF995B"
                app:strokeWidth="1dp" />

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdicionalTabBuscar"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Buscar"
                android:textAllCaps="false"
                android:textColor="#51606B"
                android:textStyle="bold"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="12dp"
                app:strokeColor="#CAD4DE"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutAdicionalNuevoContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtAdicionalesLoading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_visitas_status"
                android:padding="12dp"
                android:text="Cargando instalación..."
                android:textColor="#2D4554"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/layoutAdicionalCliente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_adicionales_card"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/txtAdicionalesCliente"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cliente"
                    android:textColor="#1A1F24"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtAdicionalesDireccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Direccion"
                    android:textColor="#2E3C46"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Email cliente"
                    android:textColor="#5A3B1E"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/editAdicionalEmailCliente"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_edittext"
                    android:hint="cliente@dominio.com"
                    android:imeOptions="actionDone"
                    android:inputType="textEmailAddress"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:textColor="#1F2933"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txtAdicionalEmailWarning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Esta referencia no tiene email. Introduce uno para este envío."
                    android:textColor="#B45309"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdicionalCambiarReferencia"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:text="Cambiar referencia"
                android:textAllCaps="false"
                android:textColor="#7B4C16"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="#FFF6E8"
                app:cornerRadius="12dp"
                app:strokeColor="#CF995B"
                app:strokeWidth="1dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Buscar artículo"
                android:textColor="#1F2933"
                android:textSize="18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editAdicionalBuscar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_edittext"
                android:hint="Código o descripción"
                android:imeOptions="actionSearch"
                android:inputType="textCapCharacters"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:textColor="#1F2933"
                android:textSize="15sp" />

            <ProgressBar
                android:id="@+id/progressAdicionalBuscar"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtAdicionalResultadosEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_adicionales_section"
                android:padding="10dp"
                android:text="Sin resultados para esta búsqueda"
                android:textColor="#5F6D76"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/llAdicionalResultados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Líneas del presupuesto"
                android:textColor="#1F2933"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_adicionales_section"
                android:orientation="horizontal"
                android:paddingLeft="10dp"
                android:paddingTop="8dp"
                android:paddingRight="10dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:text="Ctd"
                    android:textColor="#5A3B1E"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Código y descripción"
                    android:textColor="#5A3B1E"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="118dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="Importe"
                    android:textColor="#5A3B1E"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtAdicionalLineasVacias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_visitas_status"
                android:padding="12dp"
                android:text="No hay artículos añadidos."
                android:textColor="#2D4554"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/llAdicionalLineas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_adicionales_card"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="TOTAL SIN IVA"
                        android:textColor="#1F2933"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtSubtotalSinIvaValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0,00 €"
                        android:textColor="#1F2933"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="IVA"
                        android:textColor="#37474F"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/txtIvaValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0,00 €"
                        android:textColor="#37474F"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="TOTAL CON IVA"
                        android:textColor="#1A1F24"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtTotalConIvaValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0,00 €"
                        android:textColor="#1A1F24"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Conforme cliente"
                android:textColor="#1F2933"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtFirmaHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Firma aquí con el dedo"
                android:textColor="#5C6A73"
                android:textSize="13sp" />

            <com.example.climamaniaapp.SignaturePadView
                android:id="@+id/signaturePad"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_adicionales_signature" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleSignatureInput"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Activar campo firma"
                    android:textAllCaps="false"
                    android:textColor="#1B7A45"
                    android:textStyle="bold"
                    app:backgroundTint="#E8F7EE"
                    app:cornerRadius="12dp"
                    app:strokeColor="#88C8A1"
                    app:strokeWidth="1dp" />

                <Space
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearSignature"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Limpiar firma"
                    android:textAllCaps="false"
                    android:textColor="#35506B"
                    android:textStyle="bold"
                    app:backgroundTint="#EEF4FF"
                    app:cornerRadius="12dp"
                    app:strokeColor="#91A9CB"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdicionalAceptar"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:enabled="true"
                android:text="Aceptar"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                app:backgroundTint="#1FA764"
                app:cornerRadius="14dp"
                app:strokeColor="#18834E"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdicionalVolver"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="6dp"
                android:text="Volver"
                android:textAllCaps="false"
                android:textColor="#3A4652"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="#F7F9FB"
                app:cornerRadius="14dp"
                app:icon="@android:drawable/ic_media_previous"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="#667382"
                app:strokeColor="#C6CFD8"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutAdicionalBuscarContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Buscar presupuestos"
                android:textColor="#1F2933"
                android:textSize="20sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editBuscarPresupuesto"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_edittext"
                android:hint="ID, pedido, cliente o teléfono"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:textColor="#1F2933"
                android:textSize="15sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/llBuscarEstados"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <ProgressBar
                android:id="@+id/progressBuscarPresupuestos"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginTop="10dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtBuscarPresupuestosEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_adicionales_section"
                android:padding="12dp"
                android:text="Sin resultados"
                android:textColor="#5F6D76"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/llBuscarPresupuestosResultados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBuscarPresupuestosMore"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:text="Cargar más"
                android:textAllCaps="false"
                android:textColor="#35506B"
                android:textStyle="bold"
                android:visibility="gone"
                app:backgroundTint="#EEF4FF"
                app:cornerRadius="12dp"
                app:strokeColor="#91A9CB"
                app:strokeWidth="1dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
