<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_visitas_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_visitas_hero"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/txtPresDetalleSaludo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hola instalador"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtPresDetalleRef"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Presupuesto #0"
                android:textAllCaps="true"
                android:textColor="#7A654F"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Detalle presupuesto"
            android:textColor="#1F2933"
            android:textSize="24sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_adicionales_card"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cliente"
                android:textColor="#5A6772"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editPresNombreCliente"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_edittext"
                android:inputType="textCapWords"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:textColor="#111111" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Dirección"
                android:textColor="#5A6772"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editPresDireccionCliente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_edittext"
                android:gravity="top|start"
                android:inputType="textCapSentences|textMultiLine"
                android:minLines="2"
                android:padding="10dp"
                android:textColor="#111111" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Teléfono"
                android:textColor="#5A6772"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editPresTelefono"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_edittext"
                android:inputType="phone"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:textColor="#111111" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Email cliente"
                android:textColor="#5A6772"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editPresEmail"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_edittext"
                android:inputType="textEmailAddress"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:textColor="#111111" />

            <TextView
                android:id="@+id/txtPresDetalleEstado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Estado: ACEPTADO"
                android:textColor="#1F2933"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtPresDetalleEquipoUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Equipo · Usuario"
                android:textColor="#5A6772"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtPresDetalleMail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Mail: pendiente"
                android:textColor="#5A6772"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPresDetalleOpenPdf"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="Abrir PDF"
                android:textAllCaps="false"
                android:textColor="#35506B"
                android:textStyle="bold"
                app:backgroundTint="#EEF4FF"
                app:cornerRadius="12dp"
                app:strokeColor="#91A9CB"
                app:strokeWidth="1dp" />

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPresDetalleOpenFirma"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="Ver firma"
                android:textAllCaps="false"
                android:textColor="#7B4C16"
                android:textStyle="bold"
                app:backgroundTint="#FFF6E8"
                app:cornerRadius="12dp"
                app:strokeColor="#CF995B"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutPresDetalleAddSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Añadir artículo"
                android:textColor="#1F2933"
                android:textSize="18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editPresDetalleBuscarArticulo"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_edittext"
                android:hint="Código o descripción"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:textColor="#111111" />

            <ProgressBar
                android:id="@+id/progressPresDetalleBuscar"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtPresDetalleResultadosEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_adicionales_section"
                android:padding="10dp"
                android:text="Sin resultados"
                android:textColor="#5F6D76"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/llPresDetalleResultados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Líneas"
            android:textColor="#1F2933"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtPresDetalleLineasVacias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_visitas_status"
            android:padding="12dp"
            android:text="No hay líneas"
            android:textColor="#2D4554"
            android:textSize="14sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/llPresDetalleLineas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_adicionales_card"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/txtPresDetalleTotalSinIva"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Total sin IVA: 0,00 €"
                android:textColor="#1F2933"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtPresDetalleTotalIva"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="IVA: 0,00 €"
                android:textColor="#37474F" />

            <TextView
                android:id="@+id/txtPresDetalleTotalConIva"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Total con IVA: 0,00 €"
                android:textColor="#1A1F24"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPresDetalleGuardar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:text="Guardar cambios"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:backgroundTint="#1FA764"
            app:cornerRadius="14dp"
            app:strokeColor="#18834E"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPresDetalleVolver"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="6dp"
            android:text="Volver"
            android:textAllCaps="false"
            android:textColor="#3A4652"
            android:textStyle="bold"
            app:backgroundTint="#F7F9FB"
            app:cornerRadius="14dp"
            app:strokeColor="#C6CFD8"
            app:strokeWidth="1dp" />
    </LinearLayout>
</ScrollView>
