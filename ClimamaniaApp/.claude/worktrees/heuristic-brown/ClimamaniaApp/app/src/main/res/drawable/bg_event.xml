<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Capa opaca para el borde -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2196F3"/> <!-- Azul sólido -->
            <corners android:radius="12dp"/>
        </shape>
    </item>

    <!-- Capa interior translúcida -->
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#B32196F3"/> <!-- Azul 70% opaco -->
            <corners android:radius="10dp"/>
        </shape>
    </item>

</layer-list>
