<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    app:cardBackgroundColor="#FFFFFD"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeColor="#E3C09B"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLineaMinus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="-"
                android:textAllCaps="false"
                android:textColor="#7A3F16"
                android:textSize="22sp"
                android:textStyle="bold"
                app:backgroundTint="#FFF2E4"
                app:cornerRadius="10dp"
                app:strokeColor="#D39B62"
                app:strokeWidth="1dp" />

            <EditText
                android:id="@+id/edtLineaCantidad"
                android:layout_width="64dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_edittext"
                android:gravity="center"
                android:hint="1"
                android:inputType="numberDecimal"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:textColor="#111111"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLineaPlus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="+"
                android:textAllCaps="false"
                android:textColor="#2D613A"
                android:textSize="22sp"
                android:textStyle="bold"
                app:backgroundTint="#EEF8F0"
                app:cornerRadius="10dp"
                app:strokeColor="#70AE7D"
                app:strokeWidth="1dp" />

            <TextView
                android:id="@+id/txtLineaCodigo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="CODIGO"
                android:textColor="#8A4A07"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLineaEliminar"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Quitar"
                android:textAllCaps="false"
                android:textColor="#7A3F16"
                android:textSize="12sp"
                app:backgroundTint="#FFF2E4"
                app:cornerRadius="10dp"
                app:strokeColor="#D39B62"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <EditText
            android:id="@+id/edtLineaDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_edittext"
            android:gravity="top|start"
            android:inputType="textCapSentences|textMultiLine"
            android:minLines="2"
            android:maxLines="3"
            android:padding="10dp"
            android:textColor="#1F2933"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtLineaPrecioUnitario"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="P. unit: 0,00 €"
                android:textColor="#394652"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtLineaPrecioTotal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="Total: 0,00 €"
                android:textColor="#111111"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtLineaIvaInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="IVA 21%"
            android:textColor="#6D5C48"
            android:textSize="12sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
