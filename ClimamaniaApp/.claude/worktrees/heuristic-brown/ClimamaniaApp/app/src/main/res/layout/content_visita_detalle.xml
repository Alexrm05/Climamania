<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_visitas_screen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_visitas_hero"
            android:padding="18dp">

            <TextView
                android:id="@+id/txtDetalleVisitaSaludo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hola instalador"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtDetalleVisitaRef"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Visita #0"
                android:textAllCaps="true"
                android:textColor="#7A654F"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtDetalleVisitaTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Detalle visita"
            android:textColor="@color/colorPrimaryDark"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtDetalleVisitaLoading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_visitas_status"
            android:padding="14dp"
            android:text="Cargando detalle de la visita..."
            android:textColor="#2D4554"
            android:textSize="14sp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDetalleVisita"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#FFFEFC"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:strokeColor="#E5D4C2"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/txtDetalleVisitaCliente"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cliente"
                    android:textColor="#1A1F24"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtDetalleVisitaDireccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_visita_info"
                    android:padding="10dp"
                    android:text="Direccion"
                    android:textColor="#37474F"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtDetalleVisitaTelefono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_visita_info"
                    android:padding="10dp"
                    android:text="Telefono"
                    android:textColor="#37474F"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtDetalleVisitaPrioridad"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_priority_low"
                        android:paddingLeft="10dp"
                        android:paddingTop="4dp"
                        android:paddingRight="10dp"
                        android:paddingBottom="4dp"
                        android:text="Sin prioridad"
                        android:textColor="#1F2937"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtDetalleVisitaEquipo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_chip_light"
                        android:paddingLeft="8dp"
                        android:paddingTop="3dp"
                        android:paddingRight="8dp"
                        android:paddingBottom="3dp"
                        android:text="Equipo: N/D"
                        android:textColor="#6D4C41"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtDetalleVisitaSolicitada"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Solicitada: --"
                    android:textColor="#37474F"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtDetalleVisitaSolicita"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_visitas_user_tag"
                    android:paddingLeft="8dp"
                    android:paddingTop="3dp"
                    android:paddingRight="8dp"
                    android:paddingBottom="3dp"
                    android:text="Solicita: --"
                    android:textColor="#8A4A07"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDetalleVisitaEnviar"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="14dp"
            android:text="Enviar información al comercial"
            android:textAllCaps="false"
            android:textColor="#2A4E88"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="#EDF2FF"
            app:cornerRadius="14dp"
            app:icon="@android:drawable/ic_menu_send"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="#3B5FA9"
            app:strokeColor="#839ACF"
            app:strokeWidth="2dp" />

        <TextView
            android:id="@+id/txtDetalleVisitaMuroTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Historial de la visita"
            android:textColor="@color/colorPrimaryDark"
            android:textSize="21sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="#D8DEE3" />

        <TextView
            android:id="@+id/txtDetalleVisitaMuroEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_visitas_status"
            android:padding="12dp"
            android:text="No hay mensajes en el historial."
            android:textColor="#2D4554"
            android:textSize="14sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/llDetalleVisitaMuroList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/txtDetalleVisitaFicherosTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Ficheros"
            android:textColor="@color/colorPrimaryDark"
            android:textSize="21sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="#D8DEE3" />

        <TextView
            android:id="@+id/txtDetalleVisitaFicherosEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_visitas_status"
            android:padding="12dp"
            android:text="No hay ficheros."
            android:textColor="#2D4554"
            android:textSize="14sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/llDetalleVisitaFicherosList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDetalleVisitaVolver"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="4dp"
            android:text="Volver"
            android:textAllCaps="false"
            android:textColor="@color/colorPrimaryDark"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="#FFFCF8"
            app:cornerRadius="14dp"
            app:icon="@android:drawable/ic_media_previous"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="#6B4A2E"
            app:strokeColor="#D9C5AF"
            app:strokeWidth="1dp" />
    </LinearLayout>
</ScrollView>
